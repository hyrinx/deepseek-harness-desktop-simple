{
  "name": "deepseek-harness-desktop-simple",
  "version": "1.0.0",
  "description": "DeepSeek Harness 轻量桌面包装",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "set NODE_OPTIONS=--use-system-ca && electron-builder --win"
  },
  "build": {
    "appId": "com.hyrinx.deepseek-harness-desktop-simple",
    "productName": "DeepSeek Harness Desktop Simple",
    "files": [
      "main.js",
      "settings.html",
      "assets/**",
      "src/**",
      "preload/**"
    ],
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/app.ico"
    }
  },
  "author": "Hyrinx",
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.7"
  },
  "dependencies": {
    "electron-menubar": "^10.2.1"
  }
}